# EmailJS (emailjs.com) — used by the contact form in src/routes/index.tsx
# Create a service + template(s) in the EmailJS dashboard, then fill these in.
# All values are meant to be used client-side (EmailJS's public key is not a secret).
VITE_EMAILJS_SERVICE_ID=your_service_id
# Sent to you (aytosonline@gmail.com) with the lead's details.
VITE_EMAILJS_TEMPLATE_ID=your_template_id
# Optional: sent back to the person who submitted the form, confirming receipt.
# Use to_name / to_email / business / message as the template variables.
# Leave unset to skip the confirmation email.
VITE_EMAILJS_CONFIRMATION_TEMPLATE_ID=your_confirmation_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
